{
    "name": "wulopay/wulopay-php",
    "description": "PHP library for the WuloPay Hosted Checkout API: checkout sessions, refunds and signed webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "wulopay",
        "payments",
        "checkout",
        "south africa",
        "webhooks"
    ],
    "homepage": "https://github.com/WuloPay/wulopay-php",
    "authors": [
        {
            "name": "WuloPay",
            "homepage": "https://www.wulopay.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "WuloPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WuloPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
